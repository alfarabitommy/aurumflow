# ============================================================
# AurumFlow — contoh konfigurasi environment
# ============================================================
# Salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# Aturan parser (app/Config/Env.php):
#   - Satu pasangan KEY=VALUE per baris.
#   - Komentar hanya boleh berada di baris tersendiri (diawali `#`).
#   - Nilai yang mengandung spasi, tanda kutip, atau `#` WAJIB dibungkus
#     tanda kutip ganda, contoh: APP_NAME="PT Aurum Flow".
#   - Variabel environment asli (getenv) MENANG atas isi file ini.
#     Ini memudahkan override di shared hosting tanpa menulis file.

# --- Aplikasi ---
APP_NAME="AurumFlow"
APP_ENV=production
APP_DEBUG=false
APP_URL="https://contoh-domain-anda.com"
APP_TIMEZONE=Asia/Jakarta

# --- Database (MySQL 8.0 / InnoDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aurumflow
DB_USER=aurumflow_user
DB_PASS=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session ---
SESSION_NAME=AURUMFLOW_SESS
SESSION_LIFETIME=7200
# Kosongkan untuk memakai session.save_path bawaan PHP.
# Isi hanya jika hosting menolak path default, contoh: /home/user/tmp/sess
SESSION_SAVE_PATH=

# --- Instalasi awal (database/install.php) ---
# Token acak untuk mengizinkan instalasi via browser pada hosting tanpa CLI.
# Hasilkan dengan: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# WAJIB dikosongkan kembali setelah instalasi selesai.
INSTALL_TOKEN=

# --- Akun operator awal (dipakai database/install.php, bukan seed statis) ---
# Sesuai ERD, identitas login adalah NOMOR TELEPON (bukan username/email).
OPERATOR_FULL_NAME="Pengelola AurumFlow"
OPERATOR_PHONE=
OPERATOR_PASSWORD=
