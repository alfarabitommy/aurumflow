# ============================================================
# AurumFlow — public/.htaccess  (document root)
# ============================================================
# Tugas file ini: mengubah SEMUA request yang bukan file statis nyata
# menjadi satu panggilan ke front controller, serta menolak akses ke
# file tersembunyi (mis. `.env`).

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Tolak seluruh dotfile SEBELUM aturan penyajian statis.
    RewriteRule (^|/)\. - [F,L]

    # 2. Sajikan apa adanya bila file/direktori benar-benar ada
    #    (assets, uploads).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Sisanya masuk ke front controller.
    RewriteRule ^ index.php [L]
</IfModule>

# Header keamanan tambahan bila mod_headers tersedia. Header utama juga
# dikirim dari public/index.php sehingga tetap ada di lingkungan lain.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Jangan pernah mengekspos file sensitif bila tersalin ke docroot.
<FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.(sql|log|md|ini|dist))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
