# ============================================================
# AurumFlow — daftar file yang TIDAK boleh masuk version control
# ============================================================

# --- Konfigurasi & secret ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Log & state runtime ---
/storage/logs/*.log
!/storage/logs/.gitignore
*.log

# --- Upload pengguna (isi tidak pernah di-commit) ---
/public/uploads/*
!/public/uploads/.gitignore
!/public/uploads/.htaccess
!/public/uploads/receipts/
!/public/uploads/receipts/.gitignore

# --- Marker instalasi ---
/storage/installed.lock

# --- Pembatas percobaan login (Fase 5; berkas JSON kecil, isi runtime) ---
/storage/throttle/*
!/storage/throttle/.gitignore

# --- Cache / artefak QC ---
/tests/.tmp/
*.tmp

# --- State runtime agen (Reasonix) ---
.reasonix/

# --- Editor & OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~
